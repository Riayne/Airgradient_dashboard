# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your token and location IDs stay on your computer.

# AirGradient API token (AirGradient dashboard > Place > Connectivity Settings).
AIRGRADIENT_API_TOKEN=your-token-here
AIRGRADIENT_BASE_URL=https://api.airgradient.com/public/api/v1
# "query" sends the token as ?token=..., "header" sends it in a header.
AIRGRADIENT_AUTH_MODE=query

# Location IDs of the monitors to show, comma-separated, in display order.
MONITOR_IDS=111111,222222,333333,444444

# Earliest date the history backfill looks for (YYYY-MM-DD).
HISTORY_START=2024-01-01

# How often (seconds) to fetch the latest readings.
REFRESH_SECONDS=60

# Local time used on the site (hours from UTC, and its label).
DISPLAY_UTC_OFFSET_HOURS=5
DISPLAY_TZ_LABEL=PKT

DATABASE_PATH=data/airgradient.sqlite
PORT=8050
